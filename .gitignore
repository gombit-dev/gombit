# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/bin/
/dist/
# `go build ./benchmarks/scripts/<cmd>` writes the executable into the CWD, so a
# single-package build at the repo root leaves a stray binary named after the
# command. Anchored to the root so the SOURCE dirs (benchmarks/scripts/footprint/,
# benchmarks/scripts/microbench/, ...) stay tracked.
/footprint
/microbench
/collect-host-info
/inspect-limits
/k6load
/report
/run-crud
/summarize
# Do not ignore /build/: the `gombit build --embed` implementation lives in
# package build at the module root. Generated apps write binaries to bin/.

# Go workspace / module tooling
vendor/
.gocache/
.gomodcache/
.tmp/
*.coverprofile
coverage.out
coverage.html
profile.out
cpu.prof
mem.prof

# Secrets and local env (keep *.example tracked)
.env
.env.*
!.env.example
!.env.*.example

# Local databases and runtime data
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Atlas / makemigrations scratch
.gombit/

# Python (benchmarks/apps/django)
__pycache__/
*.pyc
.venv/
*.egg-info/

# Ruby (benchmarks/apps/rails)
/benchmarks/apps/rails/.bundle/
/benchmarks/apps/rails/config/*.key

# Node / frontend (future Vite apps)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.next/
.vite/
*.tsbuildinfo

# NestJS benchmark app (benchmarks/apps/nestjs) compiled output
/benchmarks/apps/nestjs/dist/
/benchmarks/apps/nestjs/coverage/

# IDE / editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

