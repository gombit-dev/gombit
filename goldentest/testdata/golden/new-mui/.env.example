# Server configuration. Copy to `.env` and fill in local values.
# Do not commit real secrets. Runtime reads these via config.Load().

GOMBIT_APP_NAME=demo
GOMBIT_ENV=development
GOMBIT_HTTP_ADDR=:8080
# Comma-separated IPs or CIDRs whose forwarded-client headers are trusted.
# Unset ignores those headers; production rejects trust-all values such as
# 0.0.0.0/0.
# GOMBIT_HTTP_TRUSTED_PROXIES=
# Per-handler request deadline, propagated into the request context (and DB/
# cache calls that honor it). The framework default is 0 (disabled); this
# scaffold sets it explicitly so new projects get a per-handler deadline out of
# the box. Set to 0 to disable and rely on the server read/write/idle timeouts.
GOMBIT_HTTP_REQUEST_TIMEOUT=60s
GOMBIT_API_PREFIX=/api/v1
GOMBIT_DOCS_ENABLED=true
GOMBIT_DATABASE_DRIVER=sqlite
# Quoted so a stray `&`/`?` in the DSN survives `set -a; . ./.env` (which would
# otherwise background the line and truncate the value). config.Load strips one
# layer of matching quotes, so the runtime value is unchanged. See #225.
GOMBIT_DATABASE_DSN="file:gombit.db?cache=shared&_fk=1"
# Whether the app needs a database; a deployment host reads it from the
# application contract (gombit contract app) to decide whether to provision one.
# GOMBIT_DATABASE_REQUIRED=true
# Connection pool. 0 keeps the driver-aware default (SQLite 1 open / 1 idle;
# PostgreSQL and MySQL 25 open / 5 idle / 30m lifetime).
# GOMBIT_DATABASE_MAX_OPEN_CONNS=0
# GOMBIT_DATABASE_MAX_IDLE_CONNS=0
# GOMBIT_DATABASE_CONN_MAX_LIFETIME=0
GOMBIT_CACHE_DRIVER=memory
GOMBIT_CACHE_NAMESPACE=demo:development
GOMBIT_REDIS_ADDR=127.0.0.1:6379
GOMBIT_REDIS_USERNAME=
GOMBIT_REDIS_PASSWORD=
GOMBIT_REDIS_DB=0
GOMBIT_REDIS_DIAL_TIMEOUT=5s
GOMBIT_REDIS_READ_TIMEOUT=3s
GOMBIT_REDIS_WRITE_TIMEOUT=3s
GOMBIT_REDIS_TLS=false
GOMBIT_REDIS_TLS_INSECURE=false

# Background jobs. sync (the default) runs a job as it is dispatched; memory
# queues inside the dispatching process. `gombit worker` / `./server worker`
# need a queue another process can reach: set GOMBIT_JOBS_DRIVER=redis, which
# uses the GOMBIT_REDIS_* settings above.
# GOMBIT_JOBS_DRIVER=sync
# GOMBIT_JOBS_QUEUE=default
# Unset derives it from GOMBIT_APP_NAME and GOMBIT_ENV (in development, the
# value below).
# GOMBIT_JOBS_NAMESPACE=demo:development

# Object storage (App.Storage()). local (the default) keeps files under
# GOMBIT_STORAGE_LOCAL_ROOT, created on the first write and gitignored;
# memory keeps them in the process, for tests; s3 uses an S3-compatible
# bucket (AWS S3, Cloudflare R2, MinIO). Leave the S3 keys unset to use the
# AWS default credential chain (an IAM role on ECS/Fargate/EC2).
# GOMBIT_STORAGE_DRIVER=local
# GOMBIT_STORAGE_LOCAL_ROOT=storage
# GOMBIT_STORAGE_S3_BUCKET=
# GOMBIT_STORAGE_S3_REGION=us-east-1
# GOMBIT_STORAGE_S3_ENDPOINT=
# GOMBIT_STORAGE_S3_PREFIX=
# GOMBIT_STORAGE_S3_ACCESS_KEY_ID=
# GOMBIT_STORAGE_S3_SECRET_ACCESS_KEY=
# GOMBIT_STORAGE_S3_FORCE_PATH_STYLE=false
# Objects under the public prefix have permanent URLs; the rest need signed
# ones. With local or memory, the app serves them at GOMBIT_STORAGE_LOCAL_URL,
# signed with GOMBIT_STORAGE_URL_SECRET (or a key derived from
# GOMBIT_JWT_SECRET). With s3, set the public objects' base URL (a CDN, or
# the bucket's address) and let anyone read the prefix in the bucket policy.
# GOMBIT_STORAGE_PUBLIC_PREFIX=public/
# GOMBIT_STORAGE_LOCAL_URL=/_storage
# GOMBIT_STORAGE_URL_SECRET=
# GOMBIT_STORAGE_S3_PUBLIC_URL=

GOMBIT_LOG_LEVEL=info
GOMBIT_LOG_SINK=stderr

# Input HTML sanitization is opt-in and off by default (issue #271). XSS is
# handled on output — the React frontend and admin escape at render time — and
# stripping markup on ingress corrupts faithful values like `x < y`. Set to
# true only if you render stored input into an HTML context you don't control;
# for a single field call framework.SanitizeHTML instead. See docs/security.md.
# GOMBIT_SECURITY_SANITIZE_INPUT=false

# HMAC secret shared by Bearer access JWTs and (in cookie mode) the CSRF
# double-submit signature. This development placeholder is shorter than 32
# characters and is rejected in production (Appendix C). `gombit new` also
# writes a gitignored `.env` with a per-project random secret. Never put
# this in VITE_*.
GOMBIT_JWT_SECRET=dev-only-not-for-production
GOMBIT_JWT_ACCESS_TTL=15m
GOMBIT_JWT_REFRESH_TTL=168h

# Public frontend values. Every VITE_* variable is inlined into the browser
# bundle — never put secrets or JWT material here.
# Empty means same-origin (Vite proxies /api during `gombit dev`). For a split
# deploy, set the API origin only. OpenAPI path keys stay /api/v1.
# gombit dev / gombit build --embed inject GOMBIT_API_PREFIX into index.html.
# A CDN must replace __GOMBIT_API_PREFIX__ in dist/index.html (or set
# window.__GOMBIT_API_PREFIX__) before serving. Do not put the prefix in VITE_*.
VITE_API_URL=
